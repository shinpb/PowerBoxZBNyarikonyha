# --- Rendszer és Arduino beállítások ---
CONFIG_AUTOSTART_ARDUINO=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# --- Zigbee Core engedélyezése ---
CONFIG_ZB_ENABLED=y
CONFIG_ZB_RADIO_NATIVE=y
CONFIG_ZB_ZED=y

# --- A Megnövelt Memóriatáblák ---
CONFIG_ZB_CONFIG_MAX_EP_NUMBER=24
CONFIG_ZB_CONFIG_BINDING_TABLE_SIZE=32
CONFIG_ZB_CONFIG_REPORT_TABLE_SIZE=48

CONFIG_ZB_CONFIG_MEMORY_BUFFER_COUNT=256
CONFIG_ZB_CONFIG_MEMORY_BUFFER_SIZE=256
CONFIG_ZB_CONFIG_ADDRESS_TABLE_SIZE=32
CONFIG_ZB_CONFIG_APS_ACK_WAIT_TABLE_SIZE=32

# --- Egyéb rádiós beállítások ---
CONFIG_IEEE802154_ENABLED=y
CONFIG_BT_ENABLED=n
CONFIG_ESP_WIFI_ENABLED=n
CONFIG_OPENTHREAD_ENABLED=n